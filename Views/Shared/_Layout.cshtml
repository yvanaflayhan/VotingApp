@{
    var hideChrome = ViewData["HideChrome"] as bool? == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string a) => controller == c && action == a ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voting_app</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="@(hideChrome ? "auth-page" : "")">
    @if (!hideChrome)
    {
        <header>
            <nav class="navbar navbar-expand-md site-nav">
                <div class="container">

                    <!-- Logo: plain text, not a link -->
                    <!-- Logo: plain text, not a link -->
                    <span class="brand-logo">
                        <span class="brand-text">Voting<span>App</span></span>
                    </span>

                    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                            data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto ms-md-4 gap-md-1">
                            <li class="nav-item">
                                <a class="nav-link @Active("Home", "Index")" asp-controller="Home"
                                   asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Home", "Privacy")" asp-controller="Home"
                                   asp-action="Privacy">Privacy</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @Active("Admin", "Users")" asp-controller="Admin"
                                       asp-action="Users">Users</a>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                var userName = User.Identity.Name ?? "";
                                var initial = userName.Length > 0 ? char.ToUpper(userName[0]).ToString() : "?";

                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="fw-medium text-secondary">Hello, @userName</span>
                                    
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        <button type="submit"
                                                class="btn btn-outline-dark btn-sm rounded-pill px-3">Logout</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <a class="btn btn-outline-dark btn-sm me-2" asp-controller="Account"
                                   asp-action="Login">Login</a>
                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (!hideChrome)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Voting_app - <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>