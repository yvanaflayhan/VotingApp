@{
    var type = (PollType)ViewBag.Type;
    var heading = $"{type} polls";
    ViewData["Title"] = heading;
}

@section Styles {
    <partial name="_DataTablesStyles" />
}

@Html.AntiForgeryToken()

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-2">@heading</h2>
        <span class="stat-chip" id="totalChip">... polls</span>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <partial name="_SearchBox" model='"Search polls..."' />
        <a class="btn btn-primary rounded-pill px-4" asp-action="Create" asp-route-type="@type">+ New poll</a>
    </div>
</div>

<partial name="_Alerts" />

<div class="users-card">
    <div class="table-responsive">
        <table id="pollsTable" class="table align-middle users-table w-100"></table>
    </div>
</div>

<partial name="_DeletePollModal" />

@section Scripts {
    <partial name="_DataTablesScripts" />
    <partial name="_PollsConfig" />
    <script src="~/js/poll-admin.js" asp-append-version="true"></script>
}