@{
    var type = (PollType)ViewBag.Type;
    var isMinePage = ViewBag.Mine == true;
    var heading = isMinePage ? "My polls" : $"{type} polls";
    ViewData["Title"] = heading;
}

@section Styles {
    <partial name="_DataTablesStyles" />
}

@Html.AntiForgeryToken()

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-2">@heading</h2>
        <span class="stat-chip" id="totalChip">... polls</span>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <partial name="_SearchBox" model='"Search polls..."' />
        @if (isMinePage)
        {
            <a class="btn btn-primary rounded-pill px-4" asp-action="Create">+ New poll</a>
        }
    </div>
</div>

<partial name="_Alerts" />

<div class="cards-wrap">
    <table id="pollsTable" class="cards-table"></table>
</div>

<partial name="_VoteModal" />
<partial name="_DeletePollModal" />

@section Scripts {
    <partial name="_DataTablesScripts" />
    <partial name="_PollsConfig" />
    <script src="~/js/poll-cards.js" asp-append-version="true"></script>
}