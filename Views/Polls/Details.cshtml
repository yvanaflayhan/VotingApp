@model PollDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
    var backAction = Model.Type == PollType.Awards ? "Awards" : "Community";
    var isAdmin = User.IsAdmin();
    var isOpen = Model.Status == PollStatus.Open;
    var canVote = isOpen && Model.IsAuthenticated && !isAdmin && Model.MyChoiceId == null;
    var myChoice = Model.Choices.FirstOrDefault(c => c.Id == Model.MyChoiceId);
}

<a asp-action="@backAction" class="text-decoration-none small">&larr; Back to @backAction polls</a>

<div class="details-card mt-3">
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img class="details-cover" src="@Model.ImagePath" alt="" />
    }
    else
    {
        <div class="details-cover poll-cover-ph">@Model.Title.Substring(0, 1).ToUpper()</div>
    }

    <div class="p-4 p-md-5">
        <div class="mb-2">
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3">@Model.Type</span>
            <partial name="_StatusBadge" model="Model.Status" />
        </div>

        <h2 class="fw-bold">@Model.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted">@Model.Description</p>
        }

        <div class="row g-3 my-3">
            <div class="col-6 col-md-3">
                <div class="info-box"><span>Total votes</span><strong>@Model.TotalVotes</strong></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="info-box"><span>Choices</span><strong>@Model.Choices.Count</strong></div>
            </div>
            <div class="col-12 col-md-6">
                <div class="info-box">
                    <span>@(Model.Status == PollStatus.Upcoming ? "Starts" : "Time remaining")</span>
                    <strong id="countdown" data-status="@Model.Status" data-start="@Model.StartDate.ToString("o")"
                            data-end="@Model.EndDate.ToString("o")"></strong>
                </div>
            </div>
        </div>

        <!-- What this visitor can do: depends on who they are and on the poll status -->
        @if (canVote)
        {
            <div id="voteArea" data-poll-id="@Model.Id" data-vote-url="@Url.Action("Vote", "Polls")">
                <h5 class="fw-bold mt-4 mb-3">Cast your vote</h5>
                @Html.AntiForgeryToken()

                @foreach (var option in Model.Choices)
                {
                    <label class="vote-choice">
                        <input type="radio" name="choiceId" value="@option.Id" />
                        <span>
                            @if (!string.IsNullOrEmpty(option.ImageUrl))
                            {
                                <img src="@option.ImageUrl" class="opt-thumb" alt="" />
                            }
                            @option.Text
                        </span>
                    </label>
                }

                <div id="voteMsg" class="alert alert-danger border-0 rounded-4 d-none mt-3"></div>
                <button type="button" id="voteBtn" class="btn btn-primary rounded-pill px-4 mt-3" disabled>Vote</button>
            </div>
        }
        else if (myChoice != null)
        {
            <div class="alert alert-success border-0 rounded-4 mt-4">
                You voted for <strong>@myChoice.Text</strong>. A vote cannot be changed.
            </div>
        }
        else if (isAdmin && isOpen)
        {
            <div class="alert alert-light border rounded-4 mt-4">
                Admins manage polls and cannot vote. You can see the live results below.
            </div>
        }
        else if (isOpen && !Model.IsAuthenticated)
        {
            <div
                class="alert alert-light border rounded-4 mt-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>Log in to vote in this poll.</span>
                <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">Login</a>
            </div>
        }
        else if (Model.Status == PollStatus.Upcoming)
        {
            <div class="alert alert-warning border-0 rounded-4 mt-4">This poll has not started yet.</div>
        }
        else if (Model.Status == PollStatus.Closed)
        {
            <div class="alert alert-secondary border-0 rounded-4 mt-4">This poll is closed.</div>
        }

        <h5 class="fw-bold mt-4 mb-3">Results</h5>
        @foreach (var option in Model.Choices)
        {
            <div class="result-row">
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-medium d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(option.ImageUrl))
                        {
                            <img src="@option.ImageUrl" class="opt-thumb lg" alt="" />
                        }
                        <span>@option.Text</span>
                        @if (option.Id == Model.MyChoiceId)
                        {
                            <span class="badge bg-primary-subtle text-primary rounded-pill">Your vote</span>
                        }
                    </span>
                    <span class="text-muted small">@option.Votes votes · @option.Percent%</span>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar" role="progressbar" style="width: @option.Percent%"></div>
                </div>
            </div>
        }

        @if (isAdmin)
        {
            <hr class="my-4" />
            <p class="text-muted small mb-0">Created by <strong>@Model.CreatorName</strong></p>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/details.js" asp-append-version="true"></script>
}