@model Voting_app.Models.PollDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
    var backAction = Model.Type == Voting_app.Models.PollType.Awards ? "Awards" : "Community";
    var badge = Model.Status switch
    {
        "Open" => "bg-success-subtle text-success",
        "Upcoming" => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-secondary-subtle text-secondary"
    };
    var isAdmin = User.IsInRole("Admin");
    var canVote = Model.Status == "Open" && Model.IsAuthenticated && !isAdmin && Model.MyChoiceId == null;
    var myChoice = Model.Choices.FirstOrDefault(c => c.Id == Model.MyChoiceId);
}

<a asp-action="@backAction" class="text-decoration-none small">&larr; Back to @backAction polls</a>

<div class="details-card mt-3">
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img class="details-cover" src="@Model.ImagePath" alt="" />
    }
    else
    {
        <div class="details-cover poll-cover-ph">@Model.Title.Substring(0, 1).ToUpper()</div>
    }

    <div class="p-4 p-md-5">
        <div class="mb-2">
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3">@Model.Type</span>
            <span class="badge @badge rounded-pill px-3">@Model.Status</span>
        </div>

        <h2 class="fw-bold">@Model.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="text-muted">@Model.Description</p>
        }

        <div class="row g-3 my-3">
            <div class="col-6 col-md-3">
                <div class="info-box"><span>Total votes</span><strong>@Model.TotalVotes</strong></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="info-box"><span>Choices</span><strong>@Model.Choices.Count</strong></div>
            </div>
            <div class="col-12 col-md-6">
                <div class="info-box">
                    <span>@(Model.Status == "Upcoming" ? "Starts" : "Time remaining")</span>
                    <strong id="countdown" data-status="@Model.Status" data-start="@Model.StartDate.ToString("o")"
                            data-end="@Model.EndDate.ToString("o")"></strong>
                </div>
            </div>
        </div>

        <!-- Voting area: depends on who is looking and on the poll status -->
        @if (canVote)
        {
            <h5 class="fw-bold mt-4 mb-3">Cast your vote</h5>
            @Html.AntiForgeryToken()
            @foreach (var c in Model.Choices)
            {
                <input type="radio" class="btn-check" name="choiceId" id="choice-@c.Id" value="@c.Id" />
                <label class="vote-option" for="choice-@c.Id">@c.Text</label>
            }
            <div id="voteMsg" class="alert alert-danger border-0 rounded-4 d-none mt-3"></div>
            <button type="button" id="voteBtn" class="btn btn-primary rounded-pill px-4 mt-3" disabled>Vote</button>
        }
        else if (myChoice != null)
        {
            <div class="alert alert-success border-0 rounded-4 mt-4">
                You voted for <strong>@myChoice.Text</strong>. A vote cannot be changed.
            </div>
        }
        else if (isAdmin && Model.Status == "Open")
        {
            <div class="alert alert-light border rounded-4 mt-4">
                Admins manage polls and cannot vote. You can see the live results below.
            </div>
        }
        else if (Model.Status == "Open" && !Model.IsAuthenticated)
        {
            <div
                class="alert alert-light border rounded-4 mt-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>Log in to vote in this poll.</span>
                <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">Login</a>
            </div>
        }
        else if (Model.Status == "Upcoming")
        {
            <div class="alert alert-warning border-0 rounded-4 mt-4">This poll has not started yet.</div>
        }
        else if (Model.Status == "Closed")
        {
            <div class="alert alert-secondary border-0 rounded-4 mt-4">This poll is closed.</div>
        }

        <h5 class="fw-bold mt-4 mb-3">Results</h5>
        @foreach (var c in Model.Choices)
        {
            <div class="result-row">
                <div class="d-flex justify-content-between mb-1">
                    <span class="fw-medium">
                        @c.Text
                        @if (c.Id == Model.MyChoiceId)
                        {
                            <span class="badge bg-primary-subtle text-primary rounded-pill ms-1">Your vote</span>
                        }
                    </span>
                    <span class="text-muted small">@c.Votes votes · @c.Percent%</span>
                </div>
                <div class="progress" style="height: 10px;">
                    <div class="progress-bar" role="progressbar" style="width: @c.Percent%"></div>
                </div>
            </div>
        }

        @if (User.IsInRole("Admin"))
        {
            <hr class="my-4" />
            <p class="text-muted small mb-0">Created by <strong>@Model.CreatorName</strong></p>
        }
    </div>
</div>

@section Scripts {
    <script>
        // ----- Countdown -----
        const el = document.getElementById('countdown');
        const start = new Date(el.dataset.start);
        const end = new Date(el.dataset.end);

        function tick() {
            if (el.dataset.status === 'Upcoming') {
                el.textContent = start.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
                return;
            }
            const ms = end - new Date();
            if (ms <= 0) { el.textContent = 'Poll ended'; return; }
            const d = Math.floor(ms / 864e5);
            const h = Math.floor(ms % 864e5 / 36e5);
            const m = Math.floor(ms % 36e5 / 6e4);
            el.textContent = `${d}d ${h}h ${m}m`;
        }
        tick();
        setInterval(tick, 30000);

        // ----- Voting -----
        const voteBtn = document.getElementById('voteBtn');
        if (voteBtn) {
            const pollId = @Model.Id;
            const csrf = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const voteMsg = document.getElementById('voteMsg');

            // The Vote button stays disabled until a choice is selected
            document.querySelectorAll('input[name="choiceId"]').forEach(r =>
                r.addEventListener('change', () => voteBtn.disabled = false));

            voteBtn.addEventListener('click', async () => {
                const selected = document.querySelector('input[name="choiceId"]:checked');
                if (!selected) return;

                voteBtn.disabled = true;
                voteMsg.classList.add('d-none');

                try {
                    const response = await fetch('@Url.Action("Vote", "Polls")', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': csrf,
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: new URLSearchParams({ pollId: pollId, choiceId: selected.value })
                    });
                    const result = await response.json();

                    if (result.success) {
                        location.reload();      // the page now shows "You voted for..." and the new results
                    } else {
                        voteMsg.textContent = result.message;
                        voteMsg.classList.remove('d-none');
                        voteBtn.disabled = false;
                    }
                } catch {
                    voteMsg.textContent = 'Something went wrong. Please try again.';
                    voteMsg.classList.remove('d-none');
                    voteBtn.disabled = false;
                }
            });
        }
    </script>
}