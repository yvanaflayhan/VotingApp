@model ChoiceInput

<div class="choice-row">
    <span class="choice-num"></span>
    <input name="Choices[0].Text" class="form-control choice-text" maxlength="200" value="@Model.Text"
           placeholder="Choice" />
    <label class="choice-photo" title="Add a photo">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" />
            <circle cx="12" cy="13" r="4" />
        </svg>
        <input type="file" name="Choices[0].Image" class="d-none choice-file"
               accept="image/png,image/jpeg,image/webp" />
    </label>
    <button type="button" class="btn-remove" aria-label="Remove choice">&times;</button>
</div>