@model List<Voting_app.Models.UserRoleViewModel>

@{
    ViewData["Title"] = "Manage users";
    var currentUserId = (string?)ViewBag.CurrentUserId;
}

<h2 class="fw-bold mb-4">Manage users</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Full name</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var isMe = u.Id == currentUserId;
                    <tr>
                        <td>@u.FullName</td>
                        <td>
                            @u.UserName
                            @if (isMe)
                            {
                                <span class="badge bg-secondary ms-1">You</span>
                            }
                        </td>
                        <td>@u.Email</td>
                        <td>
                            <form asp-action="ChangeRole" method="post">
                                <input type="hidden" name="userId" value="@u.Id" />

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="role" value="User" id="user-@u.Id"
                                           checked="@(u.Role == "User")" disabled="@isMe" onchange="this.form.submit()" />
                                    <label class="form-check-label" for="user-@u.Id">User</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="role" value="Admin" id="admin-@u.Id"
                                           checked="@(u.Role == "Admin")" disabled="@isMe" onchange="this.form.submit()" />
                                    <label class="form-check-label" for="admin-@u.Id">Admin</label>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>