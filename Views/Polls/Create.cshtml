@model CreatePollViewModel

@{
    ViewData["Title"] = "New poll";
    var rows = Model.Choices.Count >= 2 ? Model.Choices : new List<ChoiceInput> { new(), new() };
    var isAwards = Model.Type == PollType.Awards;
    var isAdmin = User.IsAdmin();
    var cancelAction = isAdmin ? (isAwards ? "Awards" : "Community") : "Mine";
}

<div class="d-flex justify-content-center py-3">
    <div class="card border-0 shadow-sm rounded-4 w-100 create-card">
        <div class="card-body p-4 p-md-5">
            <h2 class="fw-bold mb-1">Create a poll</h2>
            <p class="text-muted mb-4">
                @(isAdmin ? "Choose a type, set the dates and add the choices." : "Set the dates and add the choices.")
            </p>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="TimezoneOffset" id="TimezoneOffset" />

                <!-- Type: only the admin sees the choice. The radios stay in the page for everybody,
                     because the script needs them, and the server forces Community for users. -->
                <div class="@(isAdmin ? "" : "d-none")">
                    <label class="form-label fw-semibold">Type</label>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Type" id="typeCommunity" value="Community"
                                   checked="@(!isAwards)" />
                            <label class="type-card" for="typeCommunity">
                                <strong>Community</strong>
                                <span>Questions and opinions from everyone</span>
                            </label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" name="Type" id="typeAwards" value="Awards"
                                   checked="@isAwards" />
                            <label class="type-card" for="typeAwards">
                                <strong>Awards</strong>
                                <span>Vote for the best, with a photo per choice</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Title and description -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" maxlength="150" placeholder="What is your question?" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" maxlength="1000"
                              placeholder="Optional: add some context"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Poll photo -->
                <div class="mb-4">
                    <label class="form-label fw-semibold">
                        Poll photo <span class="text-muted fw-normal">(optional, JPG / PNG / WEBP, max 2 MB)</span>
                    </label>
                    <input type="file" name="Image" id="Image" class="form-control"
                           accept="image/png,image/jpeg,image/webp" />
                    <span asp-validation-for="Image" class="text-danger small d-block"></span>
                    <img id="imagePreview" class="image-preview d-none" alt="Preview" />
                </div>

                <!-- Dates (poll-form.js fills the defaults, in the visitor's local time) -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-semibold"></label>
                        <input asp-for="StartDate" type="datetime-local" id="StartDate"
                               asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-semibold"></label>
                        <input asp-for="EndDate" type="datetime-local" id="EndDate"
                               asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Choices (create-poll.js adds, removes and numbers the rows) -->
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label fw-semibold mb-0">Choices</label>
                    <span class="text-muted small" id="choiceCount"></span>
                </div>
                <p class="text-muted small mb-2 awards-hint">
                    Awards: click the round camera next to a choice to add its photo (JPG / PNG / WEBP, max 2 MB).
                </p>

                <div id="choiceList" class="@(isAwards ? "awards-mode" : "")">
                    @foreach (var row in rows)
                    {
                        <partial name="_ChoiceRow" model="row" />
                    }
                </div>
                <span asp-validation-for="Choices" class="text-danger small d-block"></span>

                <button type="button" id="addChoice" class="btn btn-outline-primary btn-sm rounded-pill px-3 mt-2">
                    + Add choice
                </button>

                <hr class="my-4" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create poll</button>
                    <a class="btn btn-outline-secondary rounded-pill px-4" asp-action="@cancelAction">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<template id="choiceTemplate">
    <partial name="_ChoiceRow" model="new ChoiceInput()" />
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/poll-form.js" asp-append-version="true"></script>
    <script src="~/js/create-poll.js" asp-append-version="true"></script>
}